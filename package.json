{
  "name": "planazo",
  "version": "0.1.0",
  "private": true,
  "description": "Planazo: ayudar a un grupo a organizar un plan.",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "seed": "pnpm --filter backend prisma db seed",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter backend exec prisma generate && pnpm --filter backend exec vitest run --coverage && pnpm --filter frontend exec vitest run --coverage && node scripts/merge-coverage.mjs",
    "coverage:diff": "node scripts/diff-cover.mjs",
    "test:e2e": "playwright test",
    "verify-subissue": "node scripts/verify-subissue.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3"
  }
}
