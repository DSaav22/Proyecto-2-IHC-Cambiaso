generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  name                String
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  plans               Plan[]
  joinedPlans         PlanMember[]
  activities          PlanActivity[]
  optionsCreated      PlanOption[]
  votes               PlanVote[]
  decisions           Plan[] @relation("PlanDecisionMaker")
  expensesPaid        PlanExpense[]      @relation("ExpensePayer")
  expensesCreated     PlanExpense[]      @relation("ExpenseCreator")
  expenseShares       PlanExpenseShare[]
  paymentsSent        PlanPayment[]      @relation("PaymentSender")
  paymentsReceived    PlanPayment[]      @relation("PaymentReceiver")
}

model Plan {
  id             String         @id @default(uuid())
  titulo         String         @default("")
  description    String
  dueDate        DateTime       @db.Date
  estado         String         @default("pendiente")
  shareCode      String         @unique
  votingClosedAt DateTime?
  winningDateOptionId String?
  winningPlaceOptionId String?
  decisionReason String?
  decidedAt      DateTime?
  decidedBy      String?
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  winningDateOption PlanOption? @relation("WinningDateOption", fields: [winningDateOptionId], references: [id], onDelete: SetNull)
  winningPlaceOption PlanOption? @relation("WinningPlaceOption", fields: [winningPlaceOptionId], references: [id], onDelete: SetNull)
  decisionMaker User? @relation("PlanDecisionMaker", fields: [decidedBy], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  members        PlanMember[]
  activities     PlanActivity[]
  options        PlanOption[]
  votes          PlanVote[]
  expenses       PlanExpense[]
  payments       PlanPayment[]

  @@index([userId, dueDate])
}

model PlanMember {
  id       String   @id @default(uuid())
  planId   String
  userId   String
  joinedAt DateTime @default(now())
  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@index([userId])
}

model PlanActivity {
  id            String   @id @default(uuid())
  planId        String?
  userId        String
  planTitle     String
  action        String
  previousState String?
  newState      String?
  details       Json?
  createdAt     DateTime @default(now())
  plan          Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([planId])
}

model PlanOption {
  id        String     @id @default(uuid())
  planId    String
  kind      String
  label     String
  createdBy String
  createdAt DateTime   @default(now())
  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  votes     PlanVote[]
  winningDatePlans Plan[] @relation("WinningDateOption")
  winningPlacePlans Plan[] @relation("WinningPlaceOption")

  @@index([planId])
}

model PlanVote {
  id        String     @id @default(uuid())
  planId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  option    PlanOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([planId, userId])
}

// Amounts are stored in cents (Bs) to keep splits and balances exact.
model PlanExpense {
  id          String             @id @default(uuid())
  planId      String
  description String
  amountCents Int
  splitMode   String
  paidById    String
  createdById String
  createdAt   DateTime           @default(now())
  plan        Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  paidBy      User               @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Cascade)
  createdBy   User               @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Cascade)
  shares      PlanExpenseShare[]

  @@index([planId])
}

model PlanExpenseShare {
  id          String      @id @default(uuid())
  expenseId   String
  userId      String
  amountCents Int
  expense     PlanExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model PlanPayment {
  id           String    @id @default(uuid())
  planId       String
  fromUserId   String
  toUserId     String
  amountCents  Int
  status       String    @default("pendiente")
  rejectReason String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  plan         Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromUser     User      @relation("PaymentSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User      @relation("PaymentReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([planId])
}
